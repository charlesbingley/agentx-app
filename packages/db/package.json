{
  "name": "@agentx-app/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "postinstall": "prisma generate --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@agentx-app/env": "workspace:*",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "catalog:",
    "dotenv": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@agentx-app/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "typescript": "^5"
  }
}
